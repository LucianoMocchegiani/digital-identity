          "name": "POST /{{verifierId}}/didcomm/request (Ed25519)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"presentationDefinition\": {\n    \"id\": \"pd-generic-jsonld\",\n    \"name\": \"Verificación de credencial genérica JSON-LD\",\n    \"purpose\": \"Verificar identidad y número de documento\",\n    \"input_descriptors\": [\n      {\n        \"id\": \"generic-credential\",\n        \"name\": \"Credencial genérica\",\n        \"purpose\": \"Presentar una GenericCredential que incluya nombre y documento\",\n        \"format\": {\n          \"ldp_vc\": {\n            \"proof_type\": [\"Ed25519Signature2018\"]\n          }\n        },\n        \"constraints\": {\n          \"fields\": [\n            {\n              \"path\": [\"$.type\"],\n              \"filter\": {\n                \"type\": \"array\",\n                \"contains\": { \"const\": \"GenericCredential\" }\n              }\n            },\n            { \"path\": [\"$.credentialSubject.name\"] },\n            { \"path\": [\"$.credentialSubject.documentNumber\"] }\n          ]\n        }\n      }\n    ]\n  },\n  \"expiresInSeconds\": 1800\n}"
            },
            "url": "{{verifierBaseUrl}}/v1/verifiers/{{verifierId}}/didcomm/request",
            "description": "**Ed25519 / VC completa.** PEX `ldp_vc` + `Ed25519Signature2018`. Los paths seleccionan la credencial; sin BBS la VP lleva la VC entera. Para selective disclosure usá el request BBS+ (QUARK-990)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.invitation) pm.collectionVariables.set('invitationUrl', res.invitation);",
                  "if (res.pendingRequestId) pm.collectionVariables.set('pendingRequestId', res.pendingRequestId);",
                  "if (res.expiresAt) pm.collectionVariables.set('pendingRequestExpiresAt', res.expiresAt);",
                  "if (res.invitation) {",
                  "  const uri = res.invitation;",
                  "  const pending = res.pendingRequestId || '';",
                  "  const exp = res.expiresAt || '';",
                  "  pm.visualizer.set(`",
                  "    <script src='https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js'><\\/script>",
                  "    <div style='display:flex;flex-direction:column;align-items:center;padding:20px;font-family:sans-serif'>",
                  "      <h3 style='margin-bottom:8px'>DIDComm — Request (invitar + verificar)</h3>",
                  "      <p style='margin:0 0 16px 0;font-size:13px;color:#555'>Escanear con quark-wallet. Consultar resultado con GET .../request/:pendingRequestId</p>",
                  "      <div id='qr'></div>",
                  "      <p style='margin-top:12px;font-size:11px;word-break:break-all;max-width:360px;text-align:center'>${uri}</p>",
                  "      <p style='font-size:12px;color:#666'>pendingRequestId: ${pending}<br/>expiresAt: ${exp}</p>",
                  "    </div>",
                  "    <script>new QRCode(document.getElementById('qr'),{text:'${uri}',width:280,height:280,correctLevel:QRCode.CorrectLevel.L})<\\/script>",
                  "  `, { uri });",
                  "}"
                ]
              }
            }
          ]
        },
