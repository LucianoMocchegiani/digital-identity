              "raw": "{\n  \"presentationDefinition\": {\n    \"id\": \"pd-generic-bbs\",\n    \"name\": \"Verificación BBS+ con selective disclosure\",\n    \"purpose\": \"Revelar solo el nombre; documentNumber queda oculto\",\n    \"input_descriptors\": [\n      {\n        \"id\": \"generic-credential-bbs\",\n        \"name\": \"GenericCredential BBS+\",\n        \"purpose\": \"Presentar VC firmada con BbsBlsSignature2020 revelando solo name\",\n        \"format\": {\n          \"ldp_vc\": {\n            \"proof_type\": [\"BbsBlsSignature2020\", \"BbsBlsSignatureProof2020\"]\n          }\n        },\n        \"constraints\": {\n          \"fields\": [\n            {\n              \"path\": [\"$.type\"],\n              \"filter\": {\n                \"type\": \"array\",\n                \"contains\": { \"const\": \"GenericCredential\" }\n              }\n            },\n            { \"path\": [\"$.credentialSubject.name\"] }\n          ]\n        }\n      }\n    ]\n  },\n  \"expiresInSeconds\": 1800\n}"
            },
            "url": "{{verifierBaseUrl}}/v1/verifiers/{{verifierId}}/didcomm/request",
            "description": "**QUARK-990.** PEX BBS+: pide solo `credentialSubject.name`. El holder deriva (`BbsBlsSignatureProof2020`) aunque no haya `limit_disclosure` en el PD (Credo 0.7 no modela BBS como SD nativo). Emisión previa con offer BBS+."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
