PORT=9001
BASE_URL=http://identity-issuer-service:9001
SERVICE_HOST=localhost
LOG_LEVEL=INFO
NODE_ENV=development

RABBITMQ_URL=amqp://identity:identity@localhost:5672

# --- Postgres (Askar store + sidecar BBS + StatusList) ---
DATABASE_URL=postgresql://identity:identity@localhost:5432/identity_issuer

# --- Askar (composición fija de este servicio) ---
ASKAR_STORE_KEY=identity-dev-askar-store-key
ASKAR_STORE_ID=identity_issuer

OID4VC_SUPPORTED_ALGS=ES256
VDR_SERVICE_URL=http://localhost:4003

# --- API key auth via identity-billing ---
API_KEY_AUTH_ENABLED=true
BILLING_URL=http://localhost:9000
BILLING_INTERNAL_TOKEN=dev-internal-change-me

