PORT=9002
BASE_URL=http://quark-verifier-service:9002
SERVICE_HOST=localhost
LOG_LEVEL=INFO
NODE_ENV=development

RABBITMQ_URL=amqp://quarkid:quarkid@localhost:5672

# --- Postgres (Askar store + domain-key + sidecar BBS) ---
DATABASE_URL=postgresql://quarkid:quarkid@localhost:5432/quarkid_verifier

# --- Askar (composición fija de este servicio) ---
ASKAR_STORE_KEY=quarkid-dev-askar-store-key
ASKAR_STORE_ID=quarkid_verifier

OID4VP_X5C_CERTIFICATES_BASE64=
OID4VP_X5C_LEAF_CERTIFICATE_KEY_ID=
OID4VP_X5C_CLIENT_ID_PREFIX=x509_hash

VDR_SERVICE_URL=http://localhost:4003
