PORT=9000
NODE_ENV=development

DATABASE_URL=postgresql://identity:identity@localhost:5432/identity_billing

# Protects /v1/admin/* (onboarding, plan changes)
ADMIN_API_KEY=dev-admin-change-me

# Shared secret for issuer/verifier → billing key validation
BILLING_INTERNAL_TOKEN=dev-internal-change-me

# JWT for self-serve /v1/auth + /v1/me + /v1/products
JWT_SECRET=dev-jwt-change-me
JWT_EXPIRES_IN=7d

# active provider: manual | mercadopago | stripe (only manual implemented in phase 1)
PAYMENT_PROVIDER=manual

# Al crear un producto, billing provisiona el tenant y lo activa
ISSUER_URL=http://localhost:9001
VERIFIER_URL=http://localhost:9002
PROVISION_ON_CREATE=true

# Rate limit GET /health (por IP)
PUBLIC_RATE_LIMIT_ENABLED=true
PUBLIC_RATE_LIMIT_TRUST_PROXY=true
PUBLIC_RATE_LIMIT_HEALTH_RPM=300

# OAuth Google / GitHub (vacío = botones ocultos en Kuatia)
# Redirect URIs a registrar en la consola del IdP:
#   {OAUTH_PUBLIC_BASE_URL}/auth/oauth/google/callback
#   {OAUTH_PUBLIC_BASE_URL}/auth/oauth/github/callback
# Túnel/prod: https://billing.kuatia.xyz/v1
OAUTH_PUBLIC_BASE_URL=http://localhost:9000/v1
OAUTH_FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
