PORT=9002
BASE_URL=http://identity-verifier-service:9002
SERVICE_HOST=localhost
LOG_LEVEL=INFO
NODE_ENV=development

RABBITMQ_URL=amqp://identity:identity@localhost:5672

# --- Postgres (Askar store + domain-key + sidecar BBS) ---
DATABASE_URL=postgresql://identity:identity@localhost:5432/identity_verifier

# --- Askar (composición fija de este servicio) ---
ASKAR_STORE_KEY=identity-dev-askar-store-key
ASKAR_STORE_ID=identity_verifier

OID4VP_X5C_CERTIFICATES_BASE64=
OID4VP_X5C_LEAF_CERTIFICATE_KEY_ID=
OID4VP_X5C_CLIENT_ID_PREFIX=x509_hash

VDR_SERVICE_URL=http://localhost:4003

# --- API key auth via identity-billing ---
API_KEY_AUTH_ENABLED=true
BILLING_URL=http://localhost:9000
BILLING_INTERNAL_TOKEN=dev-internal-change-me

# --- Rate limit rutas públicas (por IP; no aplica con X-API-Key) ---
PUBLIC_RATE_LIMIT_ENABLED=true
PUBLIC_RATE_LIMIT_TRUST_PROXY=true
PUBLIC_RATE_LIMIT_HEALTH_RPM=300
PUBLIC_RATE_LIMIT_DISCOVERY_RPM=120
PUBLIC_RATE_LIMIT_PROTOCOL_RPM=180

